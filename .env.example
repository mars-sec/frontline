# Frontline credentials
# Copy this file to .env and fill in your values.
# Real environment variables always take precedence over this file.

# Required for Claude backend (default). Get a key at:
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Only needed if your API key is a "Personal" / identity-linked key
# scoped to "All workspaces". Find it in the Claude Console under
# Settings -> Workspaces. Plain service-account keys don't need this.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
