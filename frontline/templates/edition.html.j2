<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ paper_name }} | {{ pretty_date }}</title>
<link rel="icon" type="image/svg+xml" href="favicon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="favicon.png">
<link rel="icon" sizes="any" href="favicon.ico">
<style>
  :root {
    --paper: #faf7f0;
    --ink: #1a1a18;
    --rule: #1a1a18;
    --muted: #6b6b64;
    --accent: #8b2500;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #191917;
      --ink: #e8e4da;
      --rule: #e8e4da;
      --muted: #97948a;
      --accent: #e0865e;
    }
  }
  * { box-sizing: border-box; margin: 0; }
  body {
    background: var(--paper);
    color: var(--ink);
    font-family: Georgia, "Times New Roman", serif;
    line-height: 1.55;
    padding: 2rem 1rem 4rem;
  }
  .sheet { max-width: 68rem; margin: 0 auto; }
  header.masthead { text-align: center; border-bottom: 4px double var(--rule); padding-bottom: 1rem; }
  .masthead h1 {
    font-size: clamp(2.4rem, 7vw, 4.5rem);
    font-weight: 900;
    letter-spacing: .02em;
    font-variant: small-caps;
  }
  .dateline {
    display: flex; justify-content: space-between; gap: 1rem;
    font-size: .85rem; text-transform: uppercase; letter-spacing: .12em;
    color: var(--muted);
    border-top: 1px solid var(--rule); margin-top: .6rem; padding-top: .4rem;
  }
  .dateline span { flex: 1; }
  .dateline span:nth-child(2) { text-align: center; }
  .dateline span:last-child { text-align: right; }
  .letter {
    margin: 1.6rem auto; max-width: 46rem; font-style: italic;
    color: var(--ink); border-left: 3px solid var(--accent);
    padding-left: 1rem; font-size: 1.02rem;
  }
  .letter .signoff { display: block; margin-top: .4rem; font-style: normal;
    font-size: .8rem; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); }
  article.lead { border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule);
    padding: 1.6rem 0; margin-bottom: 2rem; }
  article.lead h2 { font-size: clamp(1.7rem, 4.5vw, 2.6rem); line-height: 1.15; font-weight: 800; }
  article.lead .summary { font-size: 1.12rem; margin-top: .8rem; max-width: 52rem; }
  .why {
    margin-top: .7rem; font-size: .95rem; color: var(--accent);
  }
  .why::before { content: "Why you care: "; font-weight: 700; font-variant: small-caps; }
  .byline { font-size: .8rem; text-transform: uppercase; letter-spacing: .1em;
    color: var(--muted); margin-top: .7rem; }
  .byline a { color: inherit; }
  section.paper-section { margin-bottom: 2.2rem; }
  section.paper-section > h3 {
    font-size: 1rem; font-variant: small-caps; letter-spacing: .18em;
    border-bottom: 2px solid var(--rule); padding-bottom: .25rem; margin-bottom: 1rem;
  }
  .stories { display: grid; grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: 1.4rem 2rem; }
  .stories article h4 { font-size: 1.18rem; line-height: 1.25; font-weight: 700; }
  .stories article .summary { margin-top: .45rem; font-size: .96rem; }
  a.story-link { color: inherit; text-decoration: none; }
  a.story-link:hover h2, a.story-link:hover h4 { text-decoration: underline; }
  footer { text-align: center; font-size: .8rem; color: var(--muted);
    border-top: 4px double var(--rule); padding-top: 1rem; }
  footer a { color: inherit; }
</style>
</head>
<body>
<div class="sheet">
  <header class="masthead">
    <h1>{{ paper_name }}</h1>
    <div class="dateline">
      <span>{{ pretty_date }}</span>
      <span>An edition of one</span>
      <span>Vol. Daily</span>
    </div>
  </header>

  <div class="letter">
    {{ edition.editors_letter }}
    <span class="signoff">- Your Editor</span>
  </div>

  {% if edition.lead %}
  <article class="lead">
    <a class="story-link" href="{{ edition.lead.url }}">
      <h2>{{ edition.lead.headline }}</h2>
    </a>
    <p class="summary">{{ edition.lead.summary }}</p>
    {% if edition.lead.why_you_care %}<p class="why">{{ edition.lead.why_you_care }}</p>{% endif %}
    <p class="byline"><a href="{{ edition.lead.url }}">{{ edition.lead.source }}</a></p>
  </article>
  {% endif %}

  {% for section in edition.sections %}
  <section class="paper-section">
    <h3>{{ section.name }}</h3>
    <div class="stories">
      {% for story in section.stories %}
      <article>
        <a class="story-link" href="{{ story.url }}"><h4>{{ story.headline }}</h4></a>
        <p class="summary">{{ story.summary }}</p>
        {% if story.why_you_care %}<p class="why">{{ story.why_you_care }}</p>{% endif %}
        <p class="byline"><a href="{{ story.url }}">{{ story.source }}</a></p>
      </article>
      {% endfor %}
    </div>
  </section>
  {% endfor %}

  <footer>
    <p>Curated and composed by AI from your feeds. Every headline links to the original.</p>
    <p><a href="https://github.com/mars-sec/frontline">GitHub</a> | <a href="https://marshallyanis.com/frontline">About this project</a></p>
  </footer>
</div>
</body>
</html>
