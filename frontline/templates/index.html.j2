<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ paper_name }} | Archive</title>
<style>
  :root { --paper: #faf7f0; --ink: #1a1a18; --muted: #6b6b64; }
  @media (prefers-color-scheme: dark) {
    :root { --paper: #191917; --ink: #e8e4da; --muted: #97948a; }
  }
  * { box-sizing: border-box; margin: 0; }
  body { background: var(--paper); color: var(--ink);
    font-family: Georgia, "Times New Roman", serif; padding: 3rem 1rem; }
  .sheet { max-width: 40rem; margin: 0 auto; }
  h1 { font-variant: small-caps; font-weight: 900; text-align: center;
    border-bottom: 4px double var(--ink); padding-bottom: .8rem; }
  ul { list-style: none; margin-top: 1.5rem; }
  li { border-bottom: 1px solid var(--muted); }
  li a { display: block; padding: .8rem .2rem; color: inherit;
    text-decoration: none; font-size: 1.1rem; }
  li a:hover { text-decoration: underline; }
</style>
</head>
<body>
<div class="sheet">
  <h1>{{ paper_name }} | Archive</h1>
  <ul>
    {% for e in editions %}
    <li><a href="{{ e.date }}.html">{{ e.date }}</a></li>
    {% else %}
    <li><a href="#">No editions yet. Run <code>frontline run</code> to create one.</a></li>
    {% endfor %}
  </ul>
</div>
</body>
</html>
